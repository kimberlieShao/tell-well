# Starts without an AI key. Demo mode supports only the examples in README.md.
EXTRACTION_MODE=demo
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:8081,http://localhost:5500,http://127.0.0.1:5500

# To enable real transcript extraction, change EXTRACTION_MODE to gemini.
# Keep the key in backend/.env, never in Expo's EXPO_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini 2.5 Flash/Flash-Lite/Pro use the GenerateContent API automatically.
# Gemini 2.5 may be unavailable to new users even when returned by ListModels.
# Verified alternative: GEMINI_MODEL=gemini-3.6-flash (requires available quota).

# Optional: enables the ElevenLabs microphone buttons. Keep this server-side.
# The browser receives only a short-lived, single-use Scribe token.
ELEVENLABS_API_KEY=

# Optional voice for spoken check-in questions. Key needs Text to Speech access.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
