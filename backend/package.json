{
  "name": "pulsewise-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "schema": "node --import tsx scripts/schema.ts",
    "demo": "node scripts/demo.mjs",
    "whoop:snapshot": "node --env-file-if-exists=.env --import tsx scripts/whoop-snapshot.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
