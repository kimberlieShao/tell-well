# Copy to .env (never commit .env) and paste the values from your app at
# https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/callback
# Optional: where the tokens are saved (keep out of git)
# WHOOP_TOKEN_FILE=whoop_tokens.json
# Optional: browser origins allowed to read the data (comma-separated)
# WHOOP_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3001
